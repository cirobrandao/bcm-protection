msgstr "Proteção anti-bot/spam para Comentários e Registro de Usuários. Sem serviços externos."

msgid "Protection"
msgstr "Proteção"

msgid "Messages"
msgstr "Mensagens"

msgid "Logs"
msgstr "Logs"

