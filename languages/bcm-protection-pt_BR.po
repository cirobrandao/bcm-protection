msgstr "Escolha onde aplicar a proteção e ajuste as verificações de tempo."

msgid "Enable on comments"
msgstr "Ativar em comentários"

msgid "Enable on registration"
msgstr "Ativar no registro"

msgid "Minimum submit time (seconds)"
msgstr "Tempo mínimo de envio (segundos)"

msgid "Max form age (hours)"
msgstr "Idade máxima do formulário (horas)"

msgid "Allowlist"
msgstr "Lista de permissão"

msgid "Allowlist IPs (one per line)"
msgstr "IPs permitidos (um por linha)"

msgid "Enable logs (recommended)"
msgstr "Ativar logs (recomendado)"

msgid "Language"
msgstr "Idioma"

msgid "UI language"
msgstr "Idioma da interface"

msgid "Select the plugin UI language."
msgstr "Selecione o idioma da interface do plugin."
